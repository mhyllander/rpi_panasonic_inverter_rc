<!DOCTYPE html>
<html>
<head>
    <title>{{.PageTitle}}</title>
    <link type="image/png" sizes="96x96" rel="icon" href="data:image/png;base64,">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * {
            font-family: arial;
        }

        div.navbar {
            display: flex;
            align-items: center;
            justify-content: space-around;
            max-width: 600px;
            background-color: #e7f0fe;
        }
        div.navitem {
            padding: 4px;
            display: inline;
            color: #3382f7;
            font-size: 16px;
            font-weight: bold;
        }
        /* Needed because div.navitem is more specific than .hidden */
        div.navitem.hidden {
            display: none;
        }
        div.navitem.navactive {
            background-color: #3382f7;
            color: white;
        }

        /* Control panel */
        .controlpanel {
            width: 100%;
            max-width: 600px;
            margin-top: 10px;
            align-items: center;
            position: fixed;
            bottom: 0;
            left: 0;
            background-color: #e7f0fe;
            border-top: 1px solid black;
            padding: 4px;
        }
        .buttons {
            float: right;
        }
        .buttons button {
            padding: 10px;
            margin-right: 10px;
            border-radius: 8px;
            border: 2px solid gray;
            font-size: 20px;
        }

        /* Info message box */
        .refresh {
            float: left;
            margin-left: 10px;
        }
        .info {
            float: left;
            margin-left: 10px;
            padding: 10px;
            border-radius: 8px;
            border: 2px solid #0a69fa;
            background-color: #5f9dfb;
            color: white;
            text-align: center;
        }

        /* Alert message box */
        .alert {
            background-color: #f44336; /* Red */
            color: white;
            padding: 4px;
            margin-top: 10px;
            margin-bottom: 10px;
        }
        .alert p {
            padding: 0px;
            margin-top: 2px;
            margin-bottom: 2px;
        }

        /* Control panel animation */
        .hidden {
            display: none;
        }
        .btn_highlight {
            background-color: #adcaf7;
        }

        /* Settings */
        .setting {
            height: 28px;
            font-size: 16px;
            display: flex;
            align-items: center;
        }
        .label {
            flex-basis: 130px;
        }
        .input input, .input select {
            font-size: inherit;
            margin-left: 0px;
            margin-right: 0px;
        }
        input[type="checkbox"] {
            margin-top: 4px;
            margin-bottom: 4px;
            width: 18px;
            height: 18px;
        }
        .tempsetting {
            height: unset;
        }
        .tempinputs {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        .tempslider {
            flex-grow: 1;
            display: flex;
        }
        .slider {
            appearance: none;
            flex-grow: 1;
            margin-top: 4px;
            margin-bottom: 4px;
            height: 18px;
            max-width: 300px;
            background: #d3d3d3;
            outline: none;
            opacity: 0.7;
            transition: opacity .2s;
        }
        .slider:hover {
            opacity: 1;
        }

        .jobset {
            display: flex;
            align-items: center;
        }
        .jobsetname {
            margin-left: 4px;
            margin-right: 8px;
            overflow-wrap: anywhere;
        }
        .editicon {
            display: inline-flex;
            padding: 4px;
            cursor: pointer;
            color: #3382f7;
        }
        .editicon svg {
            width: 20px;
            height: 20px;
            fill: currentColor;
        }

        /* Edit */
        .hint {
            font-size: 16px;
            color: #555;
        }
        .cronjob {
            max-width: 600px;
            margin-bottom: 12px;
            padding: 6px;
            border: 1px solid #3382f7;
            border-radius: 8px;
        }
        .cronjobheader {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
            font-weight: bold;
            font-size: 16px;
        }
        .cronjobtitle {
            overflow-wrap: anywhere;
        }
        .cronjobheader button, .addbutton {
            padding: 6px;
            border-radius: 8px;
            border: 2px solid gray;
            font-size: 16px;
        }
        .input input[type="text"] {
            width: 100%;
            box-sizing: border-box;
        }

        /* Responsive layout */
        @media (max-width: 280px) {
            .setting {
                flex-direction: column;
                height: unset;
                margin-bottom: 10px;
            }
            .label {
                flex-basis: unset;
                align-self: flex-start;
            }
            .input {
                align-self: flex-end;
            }
        }

        /* Input validation */
        input:invalid {
            border: 2px dashed red;
        }
        input:invalid:required {
            background-color: rgb(250,200,200);
        }
    </style>
</head>
<body>
    <h1>{{.PageTitle}}</h1>
    <div class="navbar">
        <div id="nav_settings" class="navitem navactive">Settings</div>
        <div id="nav_schedule" class="navitem">Schedule</div>
        <div id="nav_edit" class="navitem hidden">Edit</div>
    </div>
    <div id="settings_section">
        <h3>Settings</h3>
        <div class="setting">
            <div class="label">Power</div>
            <div class="input">
                <input type="checkbox" id="power">
            </div>
        </div>
        <div class="setting">
            <div class="label">Mode</div>
            <div class="input">
                <select id="mode">
                    <option value="heat">Heat</option>
                    <option value="cool">Cool</option>
                    <option value="dry">Dry</option>
                    <option value="auto" selected>Auto</option>
                </select>
            </div>
        </div>
        <div class="setting">
            <div class="label">Powerful</div>
            <div class="input">
                <input type="checkbox" id="powerful">
            </div>
        </div>
        <div class="setting">
            <div class="label">Quiet</div>
            <div class="input">
                <input type="checkbox" id="quiet">
            </div>
        </div>
        <div class="setting tempsetting">
            <div class="label">Temperature</div>
            <div class="input tempinputs">
                <div class="tempinput">
                    <input type="number" id="temperature" min="16" max="30" value="20" required>
                </div>
                <div class="tempslider">
                    <input type="range" id="temperature_slider" class="slider" min="16" max="30" value="20">
                </div>
            </div>
        </div>
        <h3>Air Flow</h3>
        <div class="setting">
            <div class="label">Fan Speed</div>
            <div class="input">
                <select id="fan_speed">
                    <option value="highest">Highest</option>
                    <option value="high">High</option>
                    <option value="middle">Middle</option>
                    <option value="low">Low</option>
                    <option value="lowest">Lowest</option>
                    <option value="auto" selected>Auto</option>
                </select>
            </div>
        </div>
        <div class="setting">
            <div class="label">Vertical Swing</div>
            <div class="input">
                <select id="vent_vertical">
                    <option value="highest">Highest</option>
                    <option value="high">High</option>
                    <option value="middle">Middle</option>
                    <option value="low">Low</option>
                    <option value="lowest">Lowest</option>
                    <option value="auto" selected>Auto</option>
                </select>
            </div>
        </div>
        <div class="setting">
            <div class="label">Horizontal Swing</div>
            <div class="input">
                <select id="vent_horizontal">
                    <option value="farleft">Far left</option>
                    <option value="left">Left</option>
                    <option value="middle">Middle</option>
                    <option value="right">Right</option>
                    <option value="farright">Far right</option>
                    <option value="auto" selected>Auto</option>
                </select>
            </div>
        </div>
        <h3>Timers</h3>
        <div class="setting">
            <div class="label">Timer On</div>
            <div class="input">
                <input type="checkbox" id="timer_on">
            </div>
        </div>
        <div class="setting">
            <div class="label">Timer On Time</div>
            <div class="input">
                <input type="time" id="timer_on_time" value="">
            </div>
        </div>
        <div class="setting">
            <div class="label">Timer Off</div>
            <div class="input">
                <input type="checkbox" id="timer_off">
            </div>
        </div>
        <div class="setting">
            <div class="label">Timer Off Time</div>
            <div class="input">
                <input type="time" id="timer_off_time" value="">
            </div>
        </div>
    </div>
    <div id="schedule_section" class="hidden">
        <h3>Job Sets</h3>
        <div id="jobsets"></div>
        <button type="button" id="sched_add_button" class="addbutton">Add jobset</button>
    </div>
    <div id="edit_section" class="hidden">
        <div id="edit_form" class="hidden">
            <h3 id="edit_title">Job Set</h3>
            <div class="setting">
                <div class="label">Name</div>
                <div class="input">
                    <input type="text" id="edit_name" maxlength="100" required>
                </div>
            </div>
            <h3>Cron Jobs</h3>
            <div id="cronjobs"></div>
            <button type="button" id="add_cronjob_button" class="addbutton">Add cron job</button>
        </div>
    </div>
    <div id="filler"></div>
    <div id="controlpanel" class="controlpanel">
        <div id="alert" class="alert hidden"></div>
        <div id="settings_buttons" class="buttons">
            <button type="button" id="refresh_button">Refresh</button>
            <button type="button" id="send_button">Send</button>
        </div>
        <div id="schedule_buttons" class="buttons hidden">
            <button type="button" id="sched_refresh_button">Refresh</button>
            <button type="button" id="sched_save_button">Save</button>
        </div>
        <div id="edit_buttons" class="buttons hidden">
            <button type="button" id="edit_delete_button">Delete</button>
            <button type="button" id="edit_cancel_button">Cancel</button>
            <button type="button" id="edit_revert_button">Revert</button>
            <button type="button" id="edit_save_button">Save</button>
        </div>
        <div id="refresh" class="refresh hidden">
            <image src="data:image/png;base64," alt="Send/Receive">
        </div>
        <div id="info" class="info hidden"></div>
    </div>
    <script type="text/javascript">
        function escapeHtml(unsafe) {
            return unsafe.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');
        }
        /* ---------------------------------------------------------------------------------------------------------------------------------------
           Settings
           ---------------------------------------------------------------------------------------------------------------------------------------
        */
        async function getSettings() {
            const response = await fetch('/api/v1/settings', {
                method: 'GET',
                mode: 'same-origin',
                cache: 'no-cache',
                redirect: 'error',
                referrerPolicy: 'no-referrer'
            })
            if (!response.ok) {
                throw new Error(`Retrieve settings failed: ${response.statusText} (${response.status})`)
            }
            return await response.json()
        }

        async function postSettings(settings) {
            const response = await fetch('/api/v1/settings', {
                method: 'POST',
                mode: 'same-origin',
                cache: 'no-cache',
                headers: {
                    'Content-Type': 'application/json',
                },
                redirect: 'error',
                referrerPolicy: 'no-referrer',
                body: JSON.stringify(settings),
            })
            if (!response.ok) {
                throw new Error(`Send settings failed: ${response.statusText} (${response.status})`)
            }
            return await response.json()
        }

        function refreshForm(settings) {
            const ePower = document.getElementById('power')
            const eMode = document.getElementById('mode')
            const ePowerful = document.getElementById('powerful')
            const eQuiet = document.getElementById('quiet')
            const eTemp = document.getElementById('temperature')
            const eTempSlider = document.getElementById('temperature_slider')
            const eFan = document.getElementById('fan_speed')
            const eVert = document.getElementById('vent_vertical')
            const eHoriz = document.getElementById('vent_horizontal')
            const eTon = document.getElementById('timer_on')
            const eTont = document.getElementById('timer_on_time')
            const eToff = document.getElementById('timer_off')
            const eTofft = document.getElementById('timer_off_time')

            // Set input values
            ePower.checked = (settings.power == 'on')
            eMode.value = settings.mode
            ePowerful.checked = (settings.powerful == 'on')
            eQuiet.checked = (settings.quiet == 'on')
            eTemp.value = settings.temp
            eTempSlider.value = settings.temp
            eFan.value = settings.fan
            eVert.value = settings.vert
            eHoriz.value = settings.horiz
            eTon.checked = (settings.ton == 'on')
            eTont.value = (settings.tont == '25:36' ? '' : settings.tont)
            eToff.checked = (settings.toff == 'on')
            eTofft.value = (settings.tofft == '25:36' ? '' : settings.tofft)

            // Set input attributes
            eFan.disabled = ePowerful.checked || eQuiet.checked
            eTont.required = eTon.checked
            eTofft.required = eToff.checked

            // Validate the input fields
            validateInput()
        }

        function storeAndRefresh(allSettings) {
            sessionStorage.setItem('paninvSettings', JSON.stringify(allSettings.settings))
            sessionStorage.setItem('paninvModeSettings', JSON.stringify(allSettings.modeSettings))
            refreshForm(allSettings.settings)
        }

        function refreshSettings(confirm) {
            getSettings()
            .then((allSettings) => {
                storeAndRefresh(allSettings)
                showRefreshIcon()
                // if (confirm) {
                //     showInfo('Refreshed')
                // }
            })
            .catch((err) => {
                if (err.name == 'TypeError' && err.message == 'Failed to fetch') {
                    displayAlerts('Could not get settings')
                } else {
                    displayAlerts(err)
                }
                console.error(err)
            })
        }

        function btnRefresh(e) {
            highlightButton(e.target)
            refreshSettings(true)
        }

        function btnSend(e) {
            highlightButton(e.target)

            const ePower = document.getElementById('power')
            const eMode = document.getElementById('mode')
            const ePowerful = document.getElementById('powerful')
            const eQuiet = document.getElementById('quiet')
            const eTemp = document.getElementById('temperature')
            const eFan = document.getElementById('fan_speed')
            const eVert = document.getElementById('vent_vertical')
            const eHoriz = document.getElementById('vent_horizontal')
            const eTon = document.getElementById('timer_on')
            const eTont = document.getElementById('timer_on_time')
            const eToff = document.getElementById('timer_off')
            const eTofft = document.getElementById('timer_off_time')

            if (!validateInput()) {
                return
            }

            const settings = JSON.parse(sessionStorage.getItem('paninvSettings'))
            let changedSettings = Object.create(null)

            const ePowerValue = ePower.checked ? 'on' : 'off'
            if (settings.power != ePowerValue) {
                changedSettings.power = ePowerValue
            }

            const eModeValue = eMode.value
            if (settings.mode != eModeValue) {
                changedSettings.mode = eModeValue
            }

            const ePowerfulValue = ePowerful.checked ? 'on' : 'off'
            if (settings.powerful != ePowerfulValue) {
                changedSettings.powerful = ePowerfulValue
            }

            const eQuietValue = eQuiet.checked ? 'on' : 'off'
            if (settings.quiet != eQuietValue) {
                changedSettings.quiet = eQuietValue
            }

            const eTempValue = eTemp.value
            if (settings.temp != eTempValue) {
                changedSettings.temp = eTempValue
            }

            if (!eFan.disabled) {
                const eFanValue = eFan.value
                if (settings.fan != eFanValue) {
                    changedSettings.fan = eFanValue
                }
            }

            const eVertValue = eVert.value
            if (settings.vert != eVertValue) {
                changedSettings.vert = eVertValue
            }

            const eHorizValue = eHoriz.value
            if (settings.horiz != eHorizValue) {
                changedSettings.horiz = eHorizValue
            }

            const eTonValue = eTon.checked ? 'on' : 'off'
            if (settings.ton != eTonValue) {
                changedSettings.ton = eTonValue
            }

            const eTontValue = eTont.value
            if (settings.tont != eTontValue && eTontValue != '') {
                changedSettings.tont = eTontValue
            }

            const eToffValue = eToff.checked ? 'on' : 'off'
            if (settings.toff != eToffValue) {
                changedSettings.toff = eToffValue
            }

            const eTofftValue = eTofft.value
            if (settings.tofft != eTofftValue && eTofftValue != '') {
                changedSettings.tofft = eTofftValue
            }

            postSettings(changedSettings)
            .then((allSettings) => {
                storeAndRefresh(allSettings)
                showRefreshIcon()
                // showInfo('Sent')
            })
            .catch((err) => {
                if (err.name == 'TypeError' && err.message == 'Failed to fetch') {
                    displayAlerts('Could not send settings')
                } else {
                    displayAlerts(err)
                }
                console.error(err)
            })
        }

        function checkMode() {
            restoreModeSettings()
        }

        function checkPowerful() {
            const ePowerful = document.getElementById('powerful')
            const eQuiet = document.getElementById('quiet')
            const eFan = document.getElementById('fan_speed')
            if (ePowerful.checked) {
                eQuiet.checked = false
                eFan.disabled = true
            }
            else if (!eQuiet.checked) {
                eFan.disabled = false
                restoreModeSettings()
            }
        }

        function checkQuiet() {
            const ePowerful = document.getElementById('powerful')
            const eQuiet = document.getElementById('quiet')
            const eFan = document.getElementById('fan_speed')
            if (eQuiet.checked) {
                ePowerful.checked = false
                eFan.disabled = true
            }
            else if (!ePowerful.checked) {
                eFan.disabled = false
                restoreModeSettings()
            }
        }

        function checkTemp() {
            const eTemp = document.getElementById('temperature')
            const eTempSlider = document.getElementById('temperature_slider')
            if (eTemp.validity.valid) {
                eTempSlider.value = eTemp.value
            }
        }

        function checkTempSlider() {
            const eTemp = document.getElementById('temperature')
            const eTempSlider = document.getElementById('temperature_slider')
            if (eTempSlider.validity.valid) {
                eTemp.value = eTempSlider.value
            }
        }

        function checkTon() {
            const eTon = document.getElementById('timer_on')
            const eTont = document.getElementById('timer_on_time')
            eTont.required = eTon.checked
        }

        function checkToff() {
            const eToff = document.getElementById('timer_off')
            const eTofft = document.getElementById('timer_off_time')
            eTofft.required = eToff.checked
        }

        function validateInput() {
            let alertMsg = ''

            const eTemp = document.getElementById('temperature')
            const eTont = document.getElementById('timer_on_time')
            const eTofft = document.getElementById('timer_off_time')

            if (!eTemp.validity.valid) {
                alertMsg += `<p>Temperature: ${eTemp.validationMessage}</p>`
            }
            if (!eTont.validity.valid) {
                alertMsg += `<p>Timer On Time: ${eTont.validationMessage}</p>`
            }
            if (!eTofft.validity.valid) {
                alertMsg += `<p>Timer Off Time: ${eTofft.validationMessage}</p>`
            }

            if (alertMsg != '') {
                displayAlerts(alertMsg)
                return false
            }

            resetAlerts()
            return true
        }

        function restoreModeSettings() {
            const modeSettings = JSON.parse(sessionStorage.getItem('paninvModeSettings'))
            const eMode = document.getElementById('mode')
            const mode = eMode.value
            const ms = modeSettings[mode]

            const eTemp = document.getElementById('temperature')
            const eTempSlider = document.getElementById('temperature_slider')
            eTemp.value = ms.temp
            eTempSlider.value = ms.temp

            const eFan = document.getElementById('fan_speed')
            eFan.value = ms.fan
        }

        /* ---------------------------------------------------------------------------------------------------------------------------------------
           Schedule
           ---------------------------------------------------------------------------------------------------------------------------------------
        */
        async function getJobsets() {
            const response = await fetch('/api/v1/jobsets', {
                method: 'GET',
                mode: 'same-origin',
                cache: 'no-cache',
                redirect: 'error',
                referrerPolicy: 'no-referrer'
            })
            if (!response.ok) {
                throw new Error(`Retrieve jobsets failed: ${response.statusText} (${response.status})`)
            }
            return await response.json()
        }

        async function postJobsets(jobsets) {
            const response = await fetch('/api/v1/jobsets', {
                method: 'POST',
                mode: 'same-origin',
                cache: 'no-cache',
                headers: {
                    'Content-Type': 'application/json',
                },
                redirect: 'error',
                referrerPolicy: 'no-referrer',
                body: JSON.stringify(jobsets),
            })
            if (!response.ok) {
                throw new Error(`Send jobsets failed: ${response.statusText} (${response.status})`)
            }
            return await response.json()
        }

        const editIconSvg = '<svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>'

        function updateJobsetsList(jobsets) {
            var list = ''
            jobsets.sort((a,b) => a.name.localeCompare(b.name))
            jobsets.forEach(js => {
                const n = escapeHtml(js.name)
                list += `<div class="jobset"><input name="${n}" type="checkbox"`
                if (js.active) {
                    list += ' checked'
                }
                list += `><span class="jobsetname">${n}</span>`
                list += `<span class="editicon" role="button" title="Edit" data-name="${n}">${editIconSvg}</span></div>`
            })

            const eList = document.getElementById('jobsets')
            eList.innerHTML = list
        }

        function storeAndUpdateJobsets(jobsets) {
            sessionStorage.setItem('paninvJobsets', JSON.stringify(jobsets))
            updateJobsetsList(jobsets)
        }

        // Ends the edit session if its jobset was deleted or renamed elsewhere. Only called from the Schedule tab.
        function closeEditIfJobsetMissing(allJobsets) {
            if (editOriginalName == null || allJobsets.some(js => js.name == editOriginalName)) {
                return
            }
            const missingName = editOriginalName
            endEdit()
            displayAlerts(`Job set "${escapeHtml(missingName)}" no longer exists`)
        }

        function refreshJobsets() {
            getJobsets()
            .then((allJobsets) => {
                storeAndUpdateJobsets(allJobsets)
                showRefreshIcon()
                resetAlerts()
                closeEditIfJobsetMissing(allJobsets)
            })
            .catch((err) => {
                if (err.name == 'TypeError' && err.message == 'Failed to fetch') {
                    displayAlerts('Could not get jobsets')
                } else {
                    displayAlerts(err)
                }
                console.error(err)
            })
        }

        function btnSchedRefresh(e) {
            highlightButton(e.target)
            refreshJobsets()
        }

        function btnSchedSave(e) {
            highlightButton(e.target)

            const eList = document.getElementById('jobsets')
            const inputs = eList.getElementsByTagName('input')

            const jobsets = JSON.parse(sessionStorage.getItem('paninvJobsets'))
            const changedJobsets = []

            for (var i = 0; i < inputs.length; i++) {
                for (var j = 0; j < jobsets.length; j++) {
                    if (inputs[i].name == jobsets[j].name) {
                        if (inputs[i].checked != jobsets[j].active) {
                            changedJobsets.push({name: jobsets[j].name, active: inputs[i].checked})
                        }
                        break
                    }
                }
            }

            postJobsets(changedJobsets)
            .then((allJobsets) => {
                storeAndUpdateJobsets(allJobsets)
                showRefreshIcon()
                // showInfo('Updated')
            })
            .catch((err) => {
                if (err.name == 'TypeError' && err.message == 'Failed to fetch') {
                    displayAlerts('Could not save jobsets')
                } else {
                    displayAlerts(err)
                }
                console.error(err)
            })
        }

        /* ---------------------------------------------------------------------------------------------------------------------------------------
           Edit
           ---------------------------------------------------------------------------------------------------------------------------------------
        */
        const onOffOptions = [['on', 'On'], ['off', 'Off']]
        const levelOptions = [['highest', 'Highest'], ['high', 'High'], ['middle', 'Middle'], ['low', 'Low'], ['lowest', 'Lowest'], ['auto', 'Auto']]
        const cronjobSettingFields = [
            {key: 'power', label: 'Power', options: onOffOptions},
            {key: 'mode', label: 'Mode', options: [['heat', 'Heat'], ['cool', 'Cool'], ['dry', 'Dry'], ['auto', 'Auto']]},
            {key: 'powerful', label: 'Powerful', options: onOffOptions},
            {key: 'quiet', label: 'Quiet', options: onOffOptions},
            {key: 'temp', label: 'Temperature', type: 'number', min: 16, max: 30},
            {key: 'fan', label: 'Fan Speed', options: levelOptions},
            {key: 'vert', label: 'Vertical Swing', options: levelOptions},
            {key: 'horiz', label: 'Horizontal Swing', options: [['farleft', 'Far left'], ['left', 'Left'], ['middle', 'Middle'], ['right', 'Right'], ['farright', 'Far right'], ['auto', 'Auto']]},
            {key: 'ton', label: 'Timer On', options: onOffOptions},
            {key: 'tont', label: 'Timer On Time', type: 'time'},
            {key: 'toff', label: 'Timer Off', options: onOffOptions},
            {key: 'tofft', label: 'Timer Off Time', type: 'time'},
        ]

        // The name of the jobset being edited, or null for a new jobset.
        var editOriginalName = null
        // The jobset as loaded from the server (used by Revert), or null if no jobset is being edited.
        var editLoaded = null
        // Incremented when an edit session starts or ends, so that responses to older requests are ignored.
        var editRequestId = 0
        // The form as it was last rendered from editLoaded, used to detect unsaved changes.
        var editSnapshot = null

        async function responseError(prefix, response) {
            const text = (await response.text()).trim()
            return new Error(`${prefix}: ${text || response.statusText} (${response.status})`)
        }

        async function sendJobset(method, name, body) {
            const options = {
                method: method,
                mode: 'same-origin',
                cache: 'no-cache',
                redirect: 'error',
                referrerPolicy: 'no-referrer',
            }
            if (body !== undefined) {
                options.headers = {'Content-Type': 'application/json'}
                options.body = JSON.stringify(body)
            }
            return await fetch('/api/v1/jobsets/' + encodeURIComponent(name), options)
        }

        function cronjobSettingHtml(field, value) {
            let input
            if (field.options) {
                input = '<select data-key="' + field.key + '"><option value="">-</option>'
                field.options.forEach(([optionValue, optionLabel]) => {
                    input += `<option value="${optionValue}"${optionValue == value ? ' selected' : ''}>${optionLabel}</option>`
                })
                input += '</select>'
            } else if (field.type == 'number') {
                input = `<input type="number" data-key="${field.key}" min="${field.min}" max="${field.max}" value="${escapeHtml(value)}">`
            } else {
                input = `<input type="time" data-key="${field.key}" value="${escapeHtml(value)}">`
            }
            return `<div class="setting"><div class="label">${field.label}</div><div class="input">${input}</div></div>`
        }

        function cronjobTitle(name, schedule) {
            return name || schedule || 'New cron job'
        }

        function addCronjobCard(cronjob) {
            const settings = cronjob.settings || {}
            let html = '<div class="cronjobheader"><span class="cronjobtitle"></span>'
            html += '<button type="button" class="cronjobremove">Remove</button></div>'
            html += `<div class="setting"><div class="label">Name</div><div class="input"><input type="text" class="cronjobname" maxlength="100" placeholder="Optional" value="${escapeHtml(cronjob.name || '')}"></div></div>`
            html += `<div class="setting"><div class="label">Schedule</div><div class="input"><input type="text" class="cronjobschedule" required placeholder="m h dom mon dow" title="Cron schedule: minute hour day-of-month month day-of-week" value="${escapeHtml(cronjob.schedule || '')}"></div></div>`
            cronjobSettingFields.forEach(field => {
                html += cronjobSettingHtml(field, settings[field.key] || '')
            })

            const card = document.createElement('div')
            card.className = 'cronjob'
            card.innerHTML = html
            document.getElementById('cronjobs').appendChild(card)

            // The title follows the inputs, but the card never moves, so that the order doesn't change while editing.
            const eName = card.querySelector('.cronjobname')
            const eSchedule = card.querySelector('.cronjobschedule')
            const eTitle = card.querySelector('.cronjobtitle')
            const updateTitle = () => { eTitle.textContent = cronjobTitle(eName.value.trim(), eSchedule.value.trim()) }
            eName.addEventListener('input', updateTitle)
            eSchedule.addEventListener('input', updateTitle)
            card.querySelector('.cronjobremove').addEventListener('click', () => card.remove())
            updateTitle()
            return card
        }

        function collectCronjob(card) {
            const settings = {}
            card.querySelectorAll('[data-key]').forEach(element => {
                if (element.value !== '') {
                    settings[element.dataset.key] = element.value
                }
            })
            const cronjob = {schedule: card.querySelector('.cronjobschedule').value.trim(), settings: settings}
            const name = card.querySelector('.cronjobname').value.trim()
            if (name) {
                cronjob.name = name
            }
            return cronjob
        }

        function readEditForm() {
            return {
                name: document.getElementById('edit_name').value.trim(),
                cronjobs: Array.from(document.querySelectorAll('#cronjobs .cronjob')).map(collectCronjob),
            }
        }

        function isEditDirty() {
            return editLoaded != null && JSON.stringify(readEditForm()) != editSnapshot
        }

        // Asks before discarding unsaved changes in the open edit session.
        function confirmDiscardEdit() {
            return !isEditDirty() || confirm('Discard unsaved changes?')
        }

        // Fills the form from editLoaded, discarding any changes in the form. Without an edit session the form is
        // cleared and hidden.
        function renderEdit() {
            const editing = editLoaded != null
            document.getElementById('edit_form').classList.toggle('hidden', !editing)
            document.getElementById('cronjobs').innerHTML = ''
            document.getElementById('edit_name').value = ''
            editSnapshot = null
            if (!editing) {
                return
            }

            const isNew = editOriginalName == null
            document.getElementById('edit_title').textContent = isNew ? 'New Job Set' : 'Job Set'
            document.getElementById('edit_name').value = editLoaded.name
            editLoaded.cronjobs.forEach(addCronjobCard)
            editSnapshot = JSON.stringify(readEditForm())

            document.getElementById('edit_delete_button').classList.toggle('hidden', isNew)
            document.getElementById('edit_revert_button').classList.toggle('hidden', isNew)
        }

        // The Edit tab is in the navbar only while a jobset is being edited.
        function updateEditNav() {
            document.getElementById('nav_edit').classList.toggle('hidden', editLoaded == null)
        }

        function beginEdit(originalName, jobset) {
            editOriginalName = originalName
            editLoaded = jobset
            renderEdit()
            updateEditNav()
            activateSection('edit')
            resetAlerts()
        }

        // Ends the edit session and discards its form. Responses to requests made for the session are ignored.
        function endEdit() {
            editOriginalName = null
            editLoaded = null
            editRequestId++
            renderEdit()
            updateEditNav()
            if (activeSection == 'edit') {
                showSection('schedule')
            }
        }

        function showErrorAlert(err, fallbackMessage) {
            if (err.name == 'TypeError' && err.message == 'Failed to fetch') {
                displayAlerts(fallbackMessage)
            } else {
                displayAlerts(escapeHtml(err.message))
            }
            console.error(err)
        }

        // Opens the Edit tab for the named jobset, or for a new jobset if name is null. Opening the jobset that is
        // already being edited only shows its tab.
        function openEdit(name) {
            // Every click supersedes pending requests, so that the last click wins.
            const requestId = ++editRequestId

            if (editLoaded != null && editOriginalName == name) {
                activateSection('edit')
                return
            }

            if (name == null) {
                if (confirmDiscardEdit()) {
                    beginEdit(null, {name: '', cronjobs: []})
                }
                return
            }

            sendJobset('GET', name)
            .then(async (response) => {
                if (!response.ok) {
                    throw await responseError('Retrieve jobset failed', response)
                }
                return await response.json()
            })
            .then((jobset) => {
                // A newer request or a closed session has superseded this one.
                if (requestId != editRequestId) {
                    return
                }
                if (confirmDiscardEdit()) {
                    beginEdit(name, jobset)
                }
            })
            .catch((err) => {
                if (requestId == editRequestId) {
                    showErrorAlert(err, 'Could not get jobset')
                }
            })
        }

        function closeEdit() {
            endEdit()
            activateSection('schedule')
        }

        function btnSchedAdd(e) {
            highlightButton(e.target)
            openEdit(null)
        }

        function btnEditSave(e) {
            highlightButton(e.target)

            const invalid = document.getElementById('edit_form').querySelector(':invalid')
            if (invalid) {
                invalid.reportValidity()
                return
            }

            const form = readEditForm()
            const isNew = editOriginalName == null

            sendJobset(isNew ? 'POST' : 'PUT', isNew ? form.name : editOriginalName, form)
            .then(async (response) => {
                if (!response.ok) {
                    throw await responseError('Save jobset failed', response)
                }
                closeEdit()
                showRefreshIcon()
            })
            .catch((err) => showErrorAlert(err, 'Could not save jobset'))
        }

        function btnEditDelete(e) {
            highlightButton(e.target)
            if (editOriginalName == null || !confirm(`Delete job set "${editOriginalName}" and all its cron jobs?`)) {
                return
            }

            sendJobset('DELETE', editOriginalName)
            .then(async (response) => {
                if (!response.ok) {
                    throw await responseError('Delete jobset failed', response)
                }
                closeEdit()
                showRefreshIcon()
            })
            .catch((err) => showErrorAlert(err, 'Could not delete jobset'))
        }

        function btnEditRevert(e) {
            highlightButton(e.target)
            renderEdit()
            resetAlerts()
        }

        function btnEditCancel(e) {
            highlightButton(e.target)
            if (confirmDiscardEdit()) {
                closeEdit()
            }
        }

        function btnAddCronjob() {
            const card = addCronjobCard({})
            card.querySelector('.cronjobschedule').focus()
        }

        /* ---------------------------------------------------------------------------------------------------------------------------------------
           Main
           ---------------------------------------------------------------------------------------------------------------------------------------
        */
        function displayAlerts(alertMsg) {
            const alert = document.getElementById('alert')
            alert.innerHTML = alertMsg
            alert.classList.remove("hidden")
        }

        function resetAlerts() {
            const alert = document.getElementById('alert')
            alert.classList.add("hidden")
            alert.innerHTML = ''
        }

        function showRefreshIcon() {
            const icon = document.getElementById('refresh')
            icon.classList.remove("hidden")
            setTimeout(() => { icon.classList.add("hidden") }, 1000)
        }

        function showInfo(infoMsg) {
            displayInfo(infoMsg)
            setTimeout(resetInfo, 2000)
        }

        function displayInfo(infoMsg) {
            const info = document.getElementById('info')
            info.innerHTML = infoMsg
            info.classList.remove("hidden")
        }

        function resetInfo() {
            const info = document.getElementById('info')
            info.classList.add("hidden")
            info.innerHTML = ''
        }

        function highlightButton(btn) {
            btn.classList.add('btn_highlight')
            setTimeout(() => btn.classList.remove('btn_highlight'), 250)
        }

        function updateFillerHeight(entries) {
            for (const entry of entries) {
                if (entry.target.id == 'controlpanel') {
                    const eFiller = document.getElementById('filler')
                    eFiller.style.height = entry.borderBoxSize[0].blockSize + "px"
                }
            }
        }

        const sections = {
            settings: {nav: 'nav_settings', section: 'settings_section', buttons: 'settings_buttons', refresh: () => refreshSettings(true)},
            schedule: {nav: 'nav_schedule', section: 'schedule_section', buttons: 'schedule_buttons', refresh: refreshJobsets},
            // The edit section is loaded explicitly by openEdit, and must not be refreshed over unsaved changes.
            edit: {nav: 'nav_edit', section: 'edit_section', buttons: 'edit_buttons', refresh: null},
        }

        // Shows a section without refreshing it, and returns the section that is shown. The Edit tab can only be
        // shown while a jobset is being edited, otherwise the Schedule tab is shown.
        function showSection(requestedSection) {
            const section = requestedSection == 'edit' && editLoaded == null ? 'schedule' : requestedSection
            activeSection = section

            for (const [name, ids] of Object.entries(sections)) {
                const active = name == section
                document.getElementById(ids.nav).classList.toggle('navactive', active)
                document.getElementById(ids.section).classList.toggle('hidden', !active)
                document.getElementById(ids.buttons).classList.toggle('hidden', !active)
            }
            return section
        }

        function activateSection(requestedSection) {
            const section = showSection(requestedSection)
            if (section != 'edit') {
                sections[section].refresh()
            }
        }

        function initialize() {
            const eNavSettings = document.getElementById('nav_settings')
            const eNavSchedule = document.getElementById('nav_schedule')
            eNavSettings.addEventListener('click', () => activateSection('settings'))
            eNavSchedule.addEventListener('click', () => activateSection('schedule'))
            document.getElementById('nav_edit').addEventListener('click', () => activateSection('edit'))

            const eRefresh = document.getElementById('refresh_button')
            const eSend = document.getElementById('send_button')
            eRefresh.addEventListener('click', btnRefresh)
            eSend.addEventListener('click', btnSend)

            const eMode = document.getElementById('mode')
            const ePowerful = document.getElementById('powerful')
            const eQuiet = document.getElementById('quiet')
            const eTemp = document.getElementById('temperature')
            const eTempSlider = document.getElementById('temperature_slider')
            const eTon = document.getElementById('timer_on')
            const eToff = document.getElementById('timer_off')

            eMode.addEventListener('change', checkMode)
            ePowerful.addEventListener('change', checkPowerful)
            eQuiet.addEventListener('change', checkQuiet)
            eTemp.addEventListener('input', checkTemp)
            eTempSlider.addEventListener('input', checkTempSlider)
            eTon.addEventListener('change', checkTon)
            eToff.addEventListener('change', checkToff)

            const eSchedRefresh = document.getElementById('sched_refresh_button')
            const eSchedSave = document.getElementById('sched_save_button')
            eSchedRefresh.addEventListener('click', btnSchedRefresh)
            eSchedSave.addEventListener('click', btnSchedSave)
            document.getElementById('sched_add_button').addEventListener('click', btnSchedAdd)
            document.getElementById('jobsets').addEventListener('click', (e) => {
                const eIcon = e.target.closest('.editicon')
                if (eIcon) {
                    openEdit(eIcon.dataset.name)
                }
            })

            document.getElementById('edit_save_button').addEventListener('click', btnEditSave)
            document.getElementById('edit_delete_button').addEventListener('click', btnEditDelete)
            document.getElementById('edit_revert_button').addEventListener('click', btnEditRevert)
            document.getElementById('edit_cancel_button').addEventListener('click', btnEditCancel)
            document.getElementById('add_cronjob_button').addEventListener('click', btnAddCronjob)

            const eControlPanel = document.getElementById('controlpanel')
            new ResizeObserver(updateFillerHeight).observe(eControlPanel)

            window.addEventListener('focus', () => {
                if (activeSection == 'settings') {
                    refreshSettings(true)
                } else if (activeSection == 'schedule') {
                    refreshJobsets()
                }
            })
            window.addEventListener('beforeunload', (e) => {
                if (isEditDirty()) {
                    e.preventDefault()
                    e.returnValue = ''
                }
            })
            activateSection('settings')
        }

        var activeSection = 'settings'

        window.addEventListener('load', initialize)
    </script>
</body>
</html>
